{
  "name": "aitothemoon",
  "version": "0.1.0",
  "description": "An AI player for Minecraft Java servers: walks, chats, runs commands, uses server menus, and learns new behaviors over time.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test-server:setup": "tsx scripts/setup-test-server.ts",
    "worldgen:setup": "tsx scripts/worldgen/setup.ts",
    "worldgen:build-plugin": "tsx scripts/worldgen/build-plugin.ts",
    "worldgen:round": "tsx scripts/worldgen/round.ts",
    "worldgen:verify": "tsx scripts/worldgen/verify.ts",
    "worldgen:play": "tsx scripts/worldgen/play.ts",
    "worldgen:analyze": "tsx scripts/worldgen/analyze.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "dotenv": "^18.0.9",
    "mineflayer": "^4.39.0",
    "mineflayer-collectblock": "^1.6.0",
    "mineflayer-pathfinder": "^2.4.5",
    "pngjs": "^7.0.0",
    "prismarine-chat": "^1.13.0",
    "prismarine-nbt": "^2.8.0",
    "vec3": "^0.1.10",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
